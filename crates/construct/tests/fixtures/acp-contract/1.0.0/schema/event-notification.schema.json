{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/strf0x1/sprawlcommons-acp/schema/event-notification.schema.json",
  "title": "Lossless event notification params",
  "type": "object",
  "required": ["sessionId", "event"],
  "properties": {
    "sessionId": { "type": "string", "minLength": 1 },
    "event": {
      "type": "object",
      "description": "Construct's journal Event: a tagged object, additive-only vocabulary.",
      "required": ["event"],
      "properties": { "event": { "type": "string", "minLength": 1 } },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
