{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/strf0x1/sprawlcommons-acp/schema/boundary-notice.schema.json",
  "title": "Late Deck boundary decision",
  "type": "object",
  "properties": {
    "approval_id": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "description": "Alias for approval_id.",
      "minLength": 1
    },
    "destination": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "description": "Defaults to `decided` when absent."
    },
    "state": {
      "type": "string",
      "description": "Alias for outcome."
    },
    "scope": {
      "type": "string"
    },
    "sessionId": {
      "type": "string",
      "description": "Target session; absent means every session."
    },
    "session_id": {
      "type": "string",
      "description": "Alias for sessionId."
    },
    "expires_at_ms": {
      "$ref": "#/$defs/grant/properties/expires_at_ms"
    }
  },
  "additionalProperties": true,
  "anyOf": [
    {
      "required": [
        "approval_id"
      ]
    },
    {
      "required": [
        "id"
      ]
    }
  ],
  "$defs": {
    "grant": {
      "type": "object",
      "properties": {
        "scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "expires_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Absolute host grant deadline in Unix milliseconds; never a relative wait or pending-item expiry."
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "scope"
            ],
            "properties": {
              "scope": {
                "const": "timed"
              }
            }
          },
          "then": {
            "required": [
              "expires_at_ms"
            ]
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/grant"
    }
  ]
}
