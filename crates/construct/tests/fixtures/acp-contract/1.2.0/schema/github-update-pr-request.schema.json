{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/strf0x1/sprawlcommons-acp/schema/github-update-pr-request.schema.json",
  "title": "GitHub `update_pr` request",
  "type": "object",
  "properties": {
    "operation": {
      "const": "update_pr"
    },
    "number": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "body": {
      "type": "string",
      "description": "Present means set, including the empty string."
    },
    "base": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._/-]{1,200}$",
      "description": "A branch name without refs/heads/; the full rules are SPEC.md \u00a711.2."
    },
    "draft": {
      "type": "boolean"
    }
  },
  "required": [
    "operation",
    "number"
  ],
  "additionalProperties": false,
  "anyOf": [
    {
      "required": [
        "title"
      ]
    },
    {
      "required": [
        "body"
      ]
    },
    {
      "required": [
        "base"
      ]
    },
    {
      "required": [
        "draft"
      ]
    }
  ]
}
