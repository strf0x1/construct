    "load_snapshot_keys": [
      "com.sprawlcommons/construct",
      "construct"
    ]
  },
  "negotiation": [
    {
      "case": "current",
      "client_meta": {
        "com.sprawlcommons/construct": {
          "events": true,
          "turn": true
        }
      },
      "expect": {
        "lossless": true,
        "event_method": "_com.sprawlcommons/construct/event",
        "turn_method": "_com.sprawlcommons/construct/turn"
      }
    },
    {
      "case": "current-events-only",
      "client_meta": {
        "com.sprawlcommons/construct": {
          "events": true
        }
      },
      "expect": {
        "lossless": true,
        "event_method": "_com.sprawlcommons/construct/event",
        "turn_method": "_construct/turn"
      }
    },
    {
      "case": "legacy",
      "client_meta": {
        "construct": {
          "events": true
        }
      },
      "expect": {
        "lossless": true,
        "event_method": "_construct/event",
        "turn_method": "_construct/turn"
      }
    },
    {
      "case": "legacy-turn-is-not-a-capability",
      "client_meta": {
        "construct": {
          "events": true,
          "turn": true
        }
      },
      "expect": {
        "lossless": true,
        "event_method": "_construct/event",
        "turn_method": "_construct/turn"
      }
    },
    {
      "case": "none",
      "client_meta": {},
      "expect": {
        "lossless": false,
        "event_method": "_construct/event",
        "turn_method": "_construct/turn"
      }
    },
    {
      "case": "both-keys-current-wins",
      "client_meta": {
        "construct": {
          "events": true
        },
        "com.sprawlcommons/construct": {
          "events": true,
          "turn": true
        }
      },
      "expect": {
        "lossless": true,
        "event_method": "_com.sprawlcommons/construct/event",
        "turn_method": "_com.sprawlcommons/construct/turn"
      }
    }
  ],
  "boundary_grants": {
    "timed_scope": "timed",
    "deadline_field": "expires_at_ms",
    "duration_ms": 300000,
    "deadline_exclusive": true,
    "capability": "boundary",
    "new_capability_required": false,
    "legacy_reader": "scope string accepted; deadline may be ignored; host authority unchanged",
    "deadline_cases": [
      {
        "case": "before-deadline",
        "decision_at_ms": 1000,
        "observed_at_ms": 300999,
        "expires_at_ms": 301000,
        "elapsed": false
      },
      {
        "case": "at-exclusive-deadline",
        "decision_at_ms": 1000,
        "observed_at_ms": 301000,
        "expires_at_ms": 301000,
        "elapsed": true
      },
      {
        "case": "late-notice-does-not-renew",
        "decision_at_ms": 1000,
        "observed_at_ms": 700000,
        "expires_at_ms": 301000,
        "elapsed": true
      }
    ]
  },
  "github": {
    "capability": {
      "meta_key": "com.sprawlcommons/deck",
      "field": "github_operations",
      "version": 1,
      "legacy_key": false
    },
    "environment": "DECK_GITHUB_URL",
    "operations": [
      {
        "operation": "publish",
        "path": "/operations/publish",
        "writes": true,
        "bundle": true,
        "request": "github-publish-request.schema.json",
        "response": "github-publish-response.schema.json"
      },
      {
        "operation": "refs",
        "path": "/operations/refs",
        "writes": false,
        "bundle": false,
        "request": "github-refs-request.schema.json",
        "response": "github-refs-response.schema.json"
      },
      {
        "operation": "create_pr",
        "path": "/operations/pull_request",
        "writes": true,
        "bundle": false,
        "request": "github-create-pr-request.schema.json",
        "response": "github-pull-request.schema.json"
      },
      {
        "operation": "update_pr",
        "path": "/operations/pull_request/update",
        "writes": true,
        "bundle": false,
        "request": "github-update-pr-request.schema.json",
        "response": "github-pull-request.schema.json"
      },
      {
        "operation": "review",
        "path": "/operations/pull_request/review",
        "writes": false,
        "bundle": false,
        "request": "github-review-request.schema.json",
        "response": "github-review-response.schema.json"
      }
    ],
    "refused_by_name": [
      "merge",
      "close",
      "delete",
      "tag",
      "release",
      "force_push",
      "workflow",
      "dispatch",
      "settings"
    ],
    "limits": {
      "json_head_bytes": 65536,
      "bundle_bytes": 16777216,
      "pr_text_bytes": 65536,
      "length_prefix": "u32-be",
      "bundle_magic": "# v2 git bundle\n"
    },
    "refusals": [
      {
        "code": "deck_github_refused",
        "status": [
          403
        ],
        "retryable": false
      },
      {
