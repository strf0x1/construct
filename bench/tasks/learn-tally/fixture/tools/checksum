#!/usr/bin/env python3
"""Prints the release checksum: sha256 over every tracked file under src/,
in path order. Release artifacts keep it in release/<version>.sha256."""
import hashlib
import os
import subprocess

os.chdir(os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
files = subprocess.run(["git", "ls-files", "src"], capture_output=True, text=True, check=True).stdout.split()
h = hashlib.sha256()
for f in sorted(files):
    with open(f, "rb") as fh:
        h.update(f.encode() + b"\0" + fh.read() + b"\0")
print(h.hexdigest())
