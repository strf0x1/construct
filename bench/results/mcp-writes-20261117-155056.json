 "driver": "\"\"\"Tier 1: normal MCP echo round trips before/after bounded stdin writes.\"\"\"\nimport json\nimport pathlib\nimport sqlite3\nimport sys\nimport tempfile\n\nROOT = pathlib.Path.cwd()\nsys.path.insert(0, str(ROOT / \"bench\"))\nimport bench\n\nbench.Construct.learn = False\nnames = [\"before\", \"after\"]\nbinaries = dict(zip(names, map(pathlib.Path, sys.argv[1:3])))\nbase = pathlib.Path(tempfile.mkdtemp(prefix=\"construct-mcp-write-bench-\"))\nraw = {name: {\"mcp_echo_ms\": [], \"wall\": []} for name in names}\ncalls = 20\nsteps = [{\"call\": \"mcp__calc__echo\", \"args\": {\"text\": f\"echo-{i}\"}} for i in range(calls)] + [{\"text\": \"done\"}]\n\ndef once(name, round_id):\n    trial = base / name / str(round_id)\n    work = trial / \"work\"\n    work.mkdir(parents=True)\n    harness = bench.Construct(trial / \"home\")\n    harness.name = name\n    harness.bin = binaries[name]\n    harness.overlay = f'[mcp.calc]\\ncommand = {json.dumps(str(bench.DEV))}\\nargs = [\"mcp-fake\"]\\ndescription = \"calculator\"\\n'\n    endpoint = bench.Endpoint(trial / \"endpoint\", script=steps)\n    try:\n        harness.configure(endpoint.url, \"mock-model\")\n        result = bench.run(harness.headless(\"use calc\", cwd=work), harness.full_env(), work, timeout=30)\n        assert result[\"rc\"] == 0 and not result[\"timed_out\"], result\n        records = endpoint.records()\n        gaps = bench.tool_gaps(records)\n        assert len(records) == calls + 1 and len(gaps) == calls, (len(records), len(gaps))\n        journal = next(harness.home.glob(\"projects/*/journal.sqlite\"))\n        with sqlite3.connect(f\"file:{journal}?mode=ro\", uri=True) as db:\n            ends = [json.loads(row[0]) for row in db.execute(\"SELECT payload FROM events WHERE type='tool_end' ORDER BY seq\")]\n        assert len(ends) == calls\n        assert all(row[\"ok\"] and row[\"output\"] == f\"echo-{i}\" for i, row in enumerate(ends)), ends\n        bench.SEEN[name] = harness\n        return gaps, result[\"wall_s\"]\n    finally:\n        endpoint.close()\n\nfor name in names:\n    once(name, \"warm\")\nfor round_id in range(5):\n    for name in names if round_id % 2 == 0 else names[::-1]:\n        gaps, wall = once(name, round_id)\n        raw[name][\"mcp_echo_ms\"].extend(gaps)\n        raw[name][\"wall\"].append(wall)\n        print(f\"round {round_id} {name}: {bench.stats(gaps)['median']:.3f} ms\", flush=True)\n\npath = bench.save(\"mcp-writes\", {\n    \"rounds\": 5, \"calls\": calls, \"raw\": raw,\n    \"summary\": {name: {metric: bench.stats(values) for metric, values in metrics.items()} for name, metrics in raw.items()},\n    \"driver\": pathlib.Path(__file__).read_text(),\n    \"baseline\": \"HEAD:mcp/conn.rs, before the bounded-write change; same debug profile and scripted server\",\n})\nprint(path)\n",
 "baseline": "HEAD:mcp/conn.rs, before the bounded-write change; same debug profile and scripted server"
